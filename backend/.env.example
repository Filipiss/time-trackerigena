# Para produção (Neon PostgreSQL)
# DATABASE_URL=postgresql://user:password@host/dbname
# FRONTEND_URL=https://your-app.vercel.app

# JWT
JWT_SECRET_KEY=troca-essa-chave-por-algo-seguro-em-producao

# E-mail (Gmail App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=sua-app-password-de-16-chars
MAIL_DEFAULT_SENDER=seuemail@gmail.com

# URL do frontend (para links de ativação no e-mail)
FRONTEND_URL=http://localhost:5173
